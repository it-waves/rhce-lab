{
  "name": "RHCE EX294 practice lab",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "onCreateCommand": "curl -fsSL https://rhce-practice-exam.pages.dev/lab/install.sh | bash",
  "postStartCommand": "lab autostart || true",
  "forwardPorts": [8294],
  "portsAttributes": {
    "8294": { "label": "RHCE Lab Console", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["START-HERE.md"] }
  }
}
